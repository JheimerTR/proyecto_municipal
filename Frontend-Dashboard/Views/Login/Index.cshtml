@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Sistema</title>
    <!-- Importamos Bootstrap que ya tienes en tu proyecto -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h3 class="text-center mb-4 fw-bold">Acceso al Sistema</h3>

            <form id="formularioLogin">
                <div class="mb-3">
                    <label for="usuarioRed" class="form-label">Usuario de Red</label>
                    <input type="text" id="usuarioRed" class="form-control" placeholder="Ingrese su usuario" required>
                </div>

                <div class="mb-4">
                    <label for="contrasena" class="form-label">Contraseña</label>
                    <input type="password" id="contrasena" class="form-control" placeholder="Ingrese su contraseña" required>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold">Ingresar</button>
            </form>

            <!-- Contenedor para mostrar errores de validación -->
            <div id="mensajeError" class="alert alert-danger mt-3 text-center" style="display: none; padding: 10px;"></div>
        </div>
    </div>

    <!-- Referencia a tu script asegurando que no se quede en caché -->
    <script src="/js/login.js" asp-append-version="true"></script>
</body>
</html>