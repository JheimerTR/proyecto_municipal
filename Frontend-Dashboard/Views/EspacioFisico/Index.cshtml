@{
    ViewData["Title"] = "Gestión de Espacios Físicos";
}

<div style="margin-top: 20px;">
    <h2 class="mb-4">Gestión de Espacios Físicos</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <input type="hidden" id="txtId" value="0" />

                <div class="col-md-4">
                    <label class="form-label fw-bold">Nombre del Espacio:</label>
                    <input type="text" id="txtNombre" class="form-control" placeholder="ej. Aula 1" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Tipo:</label>
                    <select id="txtTipo" class="form-select">
                        <option value="Aula">Aula</option>
                        <option value="Laboratorio">Laboratorio</option>
                        <option value="Taller">Taller</option>
                        <option value="Auditorio">Auditorio</option>
                        <option value="Cancha">Cancha</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Capacidad:</label>
                    <input type="number" id="txtCapacidadMaxima" class="form-control" placeholder="Ej. 30" />
                </div>

                <div class="col-md-3">
                    <button type="button" class="btn btn-primary me-2" onclick="Guardar(event)">Guardar</button>
                    <button type="button" class="btn btn-secondary" onclick="LimpiarFormulario()">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover" style="width: 100%; text-align: left;">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Capacidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-datos"></tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const rolSeguridad = localStorage.getItem("rolUsuario");

        // Si no es ni Admin ni Secretaria, para afuera
        if (rolSeguridad !== "Admin" && rolSeguridad !== "Secretaria") {
            window.location.replace("/Home");
        }
    });
</script>
@section Scripts {
    <script src="~/js/espaciofisico.js?v=2"></script>
}