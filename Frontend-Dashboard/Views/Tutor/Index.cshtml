@{
    ViewData["Title"] = "Gestión de Tutores";
}

<div style="margin-top: 20px;">
    <h2 class="mb-4">Gestión de Tutores</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <input type="hidden" id="txtId" value="0" />

                <div class="col-md-4">
                    <label class="form-label fw-bold">Nombre Completo:</label>
                    <input type="text" id="txtNombre" class="form-control" placeholder="Nombre del tutor" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Identificación (CI):</label>
                    <input type="text" id="txtIdentificacion" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Teléfono:</label>
                    <input type="text" id="txtTelefono" class="form-control" placeholder="Ej. 70000000" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Correo Electrónico:</label>
                    <input type="email" id="txtEmail" class="form-control" placeholder="correo@ejemplo.com" />
                </div>

                <div class="col-md-12 mt-4 text-end">
                    <button type="button" class="btn btn-primary me-2" onclick="Guardar(event)">Guardar / Actualizar</button>
                    <button type="button" class="btn btn-secondary" onclick="LimpiarFormulario()">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover" style="width: 100%; text-align: left;">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Identificación</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-datos"></tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const rolSeguridad = localStorage.getItem("rolUsuario");

        // Si no es ni Admin ni Secretaria, para afuera
        if (rolSeguridad !== "Admin" && rolSeguridad !== "Secretaria") {
            window.location.replace("/Home");
        }
    });
</script>
@section Scripts {
    <script src="~/js/tutor.js?v=2"></script>
}