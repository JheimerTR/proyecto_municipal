@{
    ViewData["Title"] = "Gestión de Asistencias";
}

<div style="margin-top: 20px;">
    <h2 class="mb-4">Gestión de Asistencias</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <input type="hidden" id="txtId" value="0" />

                <div class="col-md-3">
                    <label class="form-label fw-bold">ID Inscripción:</label>
                    <input type="number" id="txtInscripcionID" class="form-control" placeholder="Ej. 1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Fecha:</label>
                    <input type="date" id="txtFecha" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Estado:</label>
                    <select id="txtEstado" class="form-select">
                        <option value="Presente">Presente</option>
                        <option value="Ausente">Ausente</option>
                        <option value="Permiso">Permiso</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Registrado Por (ID):</label>
                    <input type="number" id="txtRegistradoPor" class="form-control" placeholder="ID Usuario" />
                </div>

                <div class="col-md-12 mt-4">
                    <button type="button" class="btn btn-primary me-2" onclick="Guardar(event)">Guardar / Actualizar</button>
                    <button type="button" class="btn btn-secondary" onclick="LimpiarFormulario()">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover" style="width: 100%; text-align: left;">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Inscripción ID</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Registrado Por</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-datos"></tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const rolSeguridad = localStorage.getItem("rolUsuario");

        // Si el localStorage está vacío (no pasó por el Login), para afuera
        if (!rolSeguridad) {
            window.location.replace("/Login");
        }
    });
</script>
@section Scripts {
    <script src="~/js/asistencia.js?v=2"></script>
}